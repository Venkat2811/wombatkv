# WombatKV env-var example. Source this file (or copy values into your shell
# rc) and adjust per environment.
#
# Convention (alpha.14+): all WombatKV env vars use the WMBT_KV_* prefix.
# Reserved sub-prefixes: WMBT_KV_TEST_*, WMBT_KV_DST_*, WMBT_KV_BENCH_*.
# Engine-facing knobs use the DS4_WOMBATKV_* prefix on the engine side.
# See docs/ENV.md for the full reference (production / tuning / debug tiers).

# --- Required to enable WombatKV at runtime ---
DS4_WOMBATKV_ENABLE=1

# --- S3-compatible backend (MinIO loopback default) ---
WMBT_KV_BUCKET=wombatkv-cache-${USER}
WMBT_KV_S3_ENDPOINT=http://127.0.0.1:9000
WMBT_KV_S3_ACCESS_KEY=minioadmin
WMBT_KV_S3_SECRET_KEY=minioadmin
WMBT_KV_S3_REGION=us-east-1
RUST_S3_SKIP_LOCATION_CONSTRAINT=true

# --- Timeouts + retries (defaults shown) ---
WMBT_KV_S3_GET_TIMEOUT_MS=2000
WMBT_KV_S3_GET_RETRIES=2
WMBT_KV_S3_RETRY_BACKOFF_MS=50

# --- Parallelism caps ---
WMBT_KV_MAX_CONCURRENT_GETS=8
WMBT_KV_MAX_CONCURRENT_PUTS=8
